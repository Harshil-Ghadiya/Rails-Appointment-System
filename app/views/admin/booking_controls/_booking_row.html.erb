<tr id="booking_row_<%= control.id %>" style="border-bottom: 1px solid #f1f1f1;">
  <%= form_with model: [:admin, control], data: { turbo: true }, html: { style: "display: contents;" } do |f| %>
    <td style="padding: 15px; vertical-align: middle;"><strong><%= control.day_name %></strong></td>
    <td style="padding: 15px; vertical-align: middle;">
      <%= f.text_field :token_prefix, style: "width: 45px; padding: 5px; border-radius: 4px; border: 1px solid #ddd;" %>
    </td>
    <td colspan="2" style="padding: 15px; vertical-align: middle;">
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        <%= f.fields_for :booking_slots do |slot_f| %>
          <div style="border: 1px solid #eee; padding: 5px; border-radius: 5px; display: flex; gap: 3px; align-items: center; background: #fafafa;">
            <%= slot_f.time_field :start_time, style: "font-size: 12px; border: 1px solid #ccc;" %>
            <span style="font-size: 11px;">-</span>
            <%= slot_f.time_field :end_time, style: "font-size: 12px; border: 1px solid #ccc;" %>
          </div>
        <% end %>
      </div>
    </td>
    <td style="padding: 15px; vertical-align: middle; text-align: center;">
      <%= f.submit "Update", style: "background: #27ae60; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;" %>
    </td>
  <% end %>
</tr>