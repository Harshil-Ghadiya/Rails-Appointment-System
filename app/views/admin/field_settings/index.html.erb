
<%= turbo_frame_tag "main_content" do %>

<%= turbo_stream_from "admin_dashboard_#{@organization.id}" %>

<div class="settings-wrapper" style="background: #f1f7f5; min-height: 100vh; font-family: 'Segoe UI', Tahoma, sans-serif;">
  
  <div style="margin-left: 50px; padding: 40px; max-width: 1000px;">
    
    <div style="margin-bottom: 30px;">
      <h2 style="color: #2c3e50; margin: 0; font-size: 28px;">⚙️ Patient Form Settings</h2>
      <p style="color: #7f8c8d; margin-top: 8px;">Check the fields you want to show on patient booking form:</p>
    </div>

<div id="field_settings_container" data-turbo-permanent>
        <%= render "admin/field_settings/settings_form", settings: @settings %>
      </div>

  </div>
</div>
<% end %>