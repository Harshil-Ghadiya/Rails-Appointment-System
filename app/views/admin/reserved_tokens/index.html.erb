<%= turbo_frame_tag "main_content" do %>
  <%= turbo_stream_from "admin_dashboard_#{@organization.id}" %>

  <div style="display: flex;">
    <div style="margin-left: 50px; padding: 30px; flex: 1; background: #f9fbff; min-height: 100vh;">
      <h2 style="color: #2c3e50;"> Manage Reserved Tokens</h2>
      <p style="color: #7f8c8d;">Tokens added here will be skipped for regular patient bookings.</p>

      <div id="reserve_form_container" style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 30px;">
        <div id="reserve_form">
          <%= render "admin/reserved_tokens/form" %>
        </div>
      </div>

      <h3 style="color: #34495e;">Currently Blocked:</h3>
      
      <div id="tokens_list" style="display: flex; flex-wrap: wrap; gap: 15px;">
        <% if @reserved_tokens.any? %>
          <% @reserved_tokens.each do |rt| %>
            <%= render "admin/reserved_tokens/token", rt: rt %>
          <% end %>
        <% else %>
          <p id="no_tokens_msg" style="color: #bdc3c7;">No tokens reserved yet.</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>